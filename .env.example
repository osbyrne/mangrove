# Defaults work locally. Credentials and crypt keys are generated in .data/.
PORT=3000
S3_PORT=9091
# Expose production only on the server's Tailscale IPv4 address:
# HOST=100.86.196.40
# Local frontend using air; starts no local API/S3 (export this when invoking bun dev):
# MANGROVE_API_URL=http://air:3000

# Override persistent storage (especially when running a release binary):
# MANGROVE_DATA_DIR=/srv/mangrove/.data
