{
  "name": "mangrove",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run scripts/run.ts dev",
    "build": "bun run --filter @mangrove/web build",
    "build:server": "VITE_API_ORIGIN= bun run build && bun run scripts/build-server.ts",
    "test:binary": "bun run scripts/smoke-binary.ts",
    "start": "bun run scripts/run.ts start",
    "import:track": "bun run scripts/import-track.ts",
    "check": "tsc --noEmit && bun run --workspaces check",
    "test": "bun run --filter @mangrove/api test",
    "verify:stream": "bun run scripts/verify-stream.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "typescript": "^6.0.0"
  }
}
